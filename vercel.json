{
  "rewrites": [{ "source": "/", "destination": "/api/page" }],
  "functions": { "api/page.js": { "includeFiles": "app/**" } },
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "same-origin" }
    ] }
  ]
}
